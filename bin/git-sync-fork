#!/usr/bin/env ruby
# git-sync-fork

# 20261018
# 0.6.0

# Notes:
# 1. Assumes that the remote is or will be called 'upstream'.
# 2. Assumes that the upstream is on the same host as origin, unless a full URL is given.
# 3. Pinched some of maybe_create_upstream_remote() from a very similar program I wrote earlier this year called git-spoon.

# Usage:
# 1. If the upstream remote called upstream doesn't exist, then run git-sync-fork with the upstream's owner and repo, or its full URL:
#  `git sync-fork owner/repo`
#  `git sync-fork git@host:owner/repo.git`
#   It will create the upstream remote and sync with upstream.
# 2. If the upstream remote called upstream does exist, then run git-sync-fork without arguments:
#  `git sync-fork`
#   It will sync with upstream.

gem 'git.rb'

require 'Git/Branch'
require 'Git/Remote'

def upstream_argument
  ARGV[0]
end

def full_url?
  upstream_argument.match?(%r{\A\w+://|\A[^/]+@[^/]+:})
end

def owner_and_repo?
  upstream_argument.match?(%r{\A[^/]+/[^/]+\z}) && Git::Remote.exist?('origin')
end

def upstream_argument_usable?
  upstream_argument && (full_url? || owner_and_repo?)
end

def origin_url
  @origin_url ||= Git::Remote.find('origin').url
end

def origin_url_sans_owner_and_repo
  origin_url.delete_suffix(origin_url[%r{[^/:]+/[^/]+\z}])
end

def git_suffix
  origin_url.end_with?('.git') ? '.git' : ''
end

def upstream_url
  if full_url?
    upstream_argument
  else
    origin_url_sans_owner_and_repo + upstream_argument.delete_suffix('.git') + git_suffix
  end
end

def maybe_create_upstream_remote
  unless Git::Remote.exist?('upstream')
    if upstream_argument_usable?
      Git::Remote.add('upstream', upstream_url)
    else
      puts "There is no remote called upstream and one could not be created."
      puts "Run `git sync-fork` again with the upstream's owner and repo, or its full URL, like so:"
      puts "", "`git sync-fork owner/repo`", ""
      exit 1
    end
  end
end

def default_branch
  @default_branch ||= Git::Branch.default
end

def on_default_branch?
  Git::Branch.current.name == default_branch
end

def run!(command)
  system(command) || exit(1)
end

def main
  maybe_create_upstream_remote
  run!('git fetch upstream')
  run!("git checkout #{default_branch}") unless on_default_branch?
  system("git merge --ff-only upstream/#{default_branch}") || abort(<<~MESSAGE)
    If #{default_branch} has commits of its own, move them to a branch and put #{default_branch} back:
      git branch <new-branch>
      git reset --hard upstream/#{default_branch}
  MESSAGE
  run!('git push')
  run!('git push --tags')
end

main
